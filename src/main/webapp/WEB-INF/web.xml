<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>班级学生成绩管理系统</display-name>

    <!-- ==================== 应用启动：初始化数据库 ==================== -->
    <listener>
        <listener-class>com.grade.listener.AppContextListener</listener-class>
    </listener>

    <!-- ==================== 过滤器 ==================== -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.grade.filter.EncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>authFilter</filter-name>
        <filter-class>com.grade.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ==================== Servlet ==================== -->
    <servlet>
        <servlet-name>loginServlet</servlet-name>
        <servlet-class>com.grade.web.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>loginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>logoutServlet</servlet-name>
        <servlet-class>com.grade.web.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>logoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>dashboardServlet</servlet-name>
        <servlet-class>com.grade.web.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>dashboardServlet</servlet-name>
        <url-pattern>/teacher/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>studentServlet</servlet-name>
        <servlet-class>com.grade.web.StudentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>studentServlet</servlet-name>
        <url-pattern>/teacher/students</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>courseServlet</servlet-name>
        <servlet-class>com.grade.web.CourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>courseServlet</servlet-name>
        <url-pattern>/teacher/courses</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>scoreServlet</servlet-name>
        <servlet-class>com.grade.web.ScoreServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>scoreServlet</servlet-name>
        <url-pattern>/teacher/scores</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>statServlet</servlet-name>
        <servlet-class>com.grade.web.StatServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>statServlet</servlet-name>
        <url-pattern>/teacher/stats</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>myScoreServlet</servlet-name>
        <servlet-class>com.grade.web.MyScoreServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>myScoreServlet</servlet-name>
        <url-pattern>/student/scores</url-pattern>
    </servlet-mapping>

    <!-- ==================== 其他配置 ==================== -->
    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>

    <!-- ==================== JSP 编码 ==================== -->
    <!-- 统一声明所有 JSP 的源文件编码，避免某个 JSP 片段漏写 page 指令时被按 ISO-8859-1 解码出现中文乱码 -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
    </jsp-config>

</web-app>
